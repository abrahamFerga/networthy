Content-Type: application/json
X-Dev-Subject: {{subject}}
X-Dev-Tenant: {{tenant}}
X-Dev-Roles: {{roles}}

{ "name": "ACME payroll", "amount": 2500, "cadence": "biweekly", "accountName": "Chase Checking" }

