<Project Sdk="Microsoft.NET.Sdk">

  <!-- The product-owned, domain-specific Plaid connector (ADR-0007): defined in THIS repo
       against Plenipo.Connectors.Sdk, registered in Networthy.Host exactly like a built-in.
       Bank linking is finance-domain-specific, so it stays out of Plenipo core; Plenipo only
       provides the generic ability for a product to define its own connector. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
    <PackageReference Include="Plenipo.Connectors.Sdk" Version="$(PlenipoVersion)" />
    <PackageReference Include="Plenipo.Application" Version="$(PlenipoVersion)" />
    <PackageReference Include="Plenipo.Modules.Sdk" Version="$(PlenipoVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Networthy.Finance\Networthy.Finance.csproj" />
  </ItemGroup>

</Project>
