{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Ai": {
    "Provider": "Mock"
  },
  "DataProtection": {
    "KeysPath": "data/dataprotection-keys"
  },
  "Security": {
    "OutboundUrls": {
      "AllowHttp": true,
      "AllowPrivateNetworks": true
    }
  }
}
