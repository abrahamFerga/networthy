<Project Sdk="Microsoft.NET.Sdk">

  <!-- Networthy's domain module — the household-finance vertical, implemented as a Plenipo
       module (IModule + manifest). The Plenipo platform (packages below) supplies auth,
       multi-tenancy, RBAC, audit, chat/agents, document tools, jobs, and connectors; this
       project owns ONLY the finance domain: accounts, transactions, categories, budgets,
       statement import, household visibility. (ADR-0001) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Networthy.Finance.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Same version the platform pins — the household OCR engine builds its own client so the
         household's scanned statements go to the household's OWN Azure resource. -->
    <PackageReference Include="Azure.AI.DocumentIntelligence" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Plenipo.Core" Version="$(PlenipoVersion)" />
    <PackageReference Include="Plenipo.Application" Version="$(PlenipoVersion)" />
    <PackageReference Include="Plenipo.Modules.Sdk" Version="$(PlenipoVersion)" />
    <PackageReference Include="Plenipo.Connectors.Sdk" Version="$(PlenipoVersion)" />
  </ItemGroup>

</Project>
